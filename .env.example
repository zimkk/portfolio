# =============================================================================
# Contact Form Configuration (EmailJS)
# =============================================================================
# Create a free account at https://emailjs.com to receive contact form enquiries
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# =============================================================================
# Blog Comments Configuration (Giscus / GitHub Discussions)
# =============================================================================
# Giscus powers comments directly through GitHub Discussions (free & open-source).
# Setup in 1 minute at https://giscus.app:
# 1. Enable 'Discussions' in your public GitHub repository settings.
# 2. Install the Giscus app: https://github.com/apps/giscus
# 3. Enter your repo details below:
VITE_GISCUS_REPO=zimkk/Portfolio-new
VITE_GISCUS_REPO_ID=your_giscus_repo_id
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=your_giscus_category_id
